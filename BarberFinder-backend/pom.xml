<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM agregador: permite compilar y probar los 3 microservicios con un solo comando
  desde la raíz del repositorio (mvn test / mvn package). Cada microservicio sigue
  siendo un proyecto Spring Boot independiente con su propio pom.xml y Dockerfile.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cl.barberfinder</groupId>
    <artifactId>barberfinder-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>BarberFinder Backend</name>

    <modules>
        <module>ms-usuarios</module>
        <module>ms-barberias</module>
        <module>ms-reservas</module>
    </modules>
</project>
