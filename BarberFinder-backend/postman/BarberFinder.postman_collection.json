                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Rojas\",\n  \"email\": \"ana{{$timestamp}}@correo.cl\",\n  \"telefono\": \"+56911223344\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Recuperar contraseña (pedir código)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/auth/recuperar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@barberfinder.cl\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.codigoDemo) pm.collectionVariables.set('codigo', j.codigoDemo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Restablecer contraseña con código",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/auth/restablecer",
            "description": "Usa el código guardado por la petición anterior. Deja la contraseña igual a {{password}} para no romper las credenciales de prueba.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@barberfinder.cl\",\n  \"codigo\": \"{{codigo}}\",\n  \"nuevaPassword\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
