{
  "info": {
    "name": "BarberFinder API",
    "description": "Endpoints de los microservicios ms-usuarios (8081), ms-barberias (8082) y ms-reservas (8083). Primero ejecuta un Login: el token queda guardado automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('fecha')) {",
          "  const d = new Date(Date.now() + 2 * 86400000);",
          "  pm.collectionVariables.set('fecha', d.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "usuarios",
      "value": "http://localhost:8081"
    },
    {
      "key": "barberias",
      "value": "http://localhost:8082"
    },
    {
      "key": "reservas",
      "value": "http://localhost:8083"
    },
    {
      "key": "password",
      "value": "Demo12345"
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": "1"
    },
    {
      "key": "barberiaId",
      "value": "1"
    },
    {
      "key": "usuarioId",
      "value": "4"
    },
    {
      "key": "codigo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Estado",
      "item": [
        {
          "name": "Estado ms-usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usuarios}}/api/estado",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Estado ms-barberias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{barberias}}/api/estado",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Estado ms-reservas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{reservas}}/api/estado",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/auth/login",
            "description": "Inicia sesión como ADMIN. Guarda el token en {{token}} (lo usan las demás peticiones) y en {{token_admin}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@barberfinder.cl\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.collectionVariables.set('token_admin', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login DUENO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
