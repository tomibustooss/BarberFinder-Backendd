# ============================================================
# BarberFinder Backend: variables de entorno
# 1) Copia este archivo como .env   (cp .env.example .env)
# 2) Cambia los valores que dicen CAMBIAR
# 3) Nunca subas el archivo .env a GitHub (ya está en .gitignore)
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CAMBIAR_root_password
DB_USER=barber
DB_PASSWORD=CAMBIAR_app_password
# Puerto de MySQL en tu PC (3307 para no chocar con un MySQL/XAMPP local)
MYSQL_PORT=3307

# ---------- JWT ----------
# Mínimo 32 caracteres. Debe ser el MISMO para los 3 microservicios.
JWT_SECRET=CAMBIAR_por_una_frase_secreta_de_minimo_32_caracteres
JWT_EXPIRATION_MINUTES=120

# ---------- Puertos de los microservicios en tu PC ----------
USUARIOS_PORT=8081
BARBERIAS_PORT=8082
RESERVAS_PORT=8083

# ---------- Datos de prueba ----------
# Crea un usuario por rol y las 6 barberías demo la primera vez que parte.
SEED_ENABLED=true
# Contraseña de los usuarios de PRUEBA (no es una contraseña real)
SEED_PASSWORD=Demo12345
# Id del usuario dueño de prueba al que se asignan las barberías demo
SEED_DUENO_ID=2

# true = /api/auth/recuperar devuelve el código en la respuesta (no hay envío de correos)
RECOVERY_DEMO_MODE=true
